{
    // Render nf-core website admonitions nicely in markdown previews
    "markdown.styles": ["https://nf-co.re/vscode_markdown.css"],
    "files.exclude": {
        "**/.venv": true,
        "**/.nf-test": true,
        "**/work": true
    },
    "search.exclude": {
        "**/.venv": true,
        "**/.nf-test": true,
        "**/work": true
    },
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/.nf-test/**": true,
        "**/work/**": true
    },
    "nextflow.files.exclude": [".git", ".nf-test", ".nf-test/**", "work", "work/**", ".venv", ".venv/**"]
}

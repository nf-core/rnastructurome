/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-core/rnastructurome Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null
    sample_id                  = null
    method                     = null
    principle                  = null
    chemical                   = null
    RT_enzyme                  = null
    pH                         = null
    organism                   = null
    fasta                      = null
    gtf                        = null
    genomes                    = null
    cutadapt_adapter_5p        = 'AGATCGGAAGAGC'  // Illumina TruSeq universal adapter; override per-sample via samplesheet adapter_5p column
    cutadapt_adapter_3p        = 'AGATCGGAAGAGC'  // Illumina TruSeq universal adapter; override per-sample via samplesheet adapter_3p column
    cutadapt_quality_only      = false
    cutadapt_5quality          = 20
    cutadapt_3quality          = 20
    cutadapt_len               = 25
    cutadapt_min_align         = 3
    cutadapt_trim_n            = true
    umi_pattern                = null
    fuzzy_untreated_pairing    = true  // Fall back to sample_group base-token matching when no exact untreated control exists, then to a single reference-wide shared untreated control if only one exists; set false for strict exact-match only

    // Alignment options
    transcriptome              = false // Use Bowtie/Bowtie2 against transcript FASTA; default (false) uses STAR against genome FASTA
    count_genome               = false // Genome route quantification: default (false) uses STAR --quantMode TranscriptomeSAM + calmd + rf-count; true uses the legacy rf-count-genome + rf-rctools extract path

    // Alignment options (STAR)
    star_multimap_nmax         = 10  // maximum number of loci a read can map to (--outFilterMultimapNmax)

    // Alignment options (Bowtie/Bowtie2)
    bowtie_k                   = 1
    bowtie_all                 = true
    bowtie_trim5               = 0
    bowtie_trim3               = 0
    bowtie_index               = null
    bowtie_n                   = 2
    bowtie_v                   = null
    bowtie_max                 = 1
    bowtie_chunkmbs            = 512
    bowtie2_preset             = '--very-sensitive-local'
    bowtie2_mp                 = '6,2'
    bowtie2_dpad               = 15
    bowtie2_rdg                = '5,3'
    bowtie2_rfg                = '5,3'
    bowtie2_softclip           = false
    bowtie2_ma                 = 2
    bowtie2_dovetail           = true
    skip_markdup               = true   // skip samtools markdup; position-based dedup is not valid for chemical-probing data without UMIs (co-starting reads are independent molecules, not PCR duplicates). UMI samples still go through umi_tools dedup.

    // Alignment options (STAR)
    star_map_sjdb_overhang      = 200             // STAR --sjdbOverhang for MaP alignment; ideally readLength-1, 200 suits 201 bp reads

    // RNAframework rf-count options (shared between transcriptome and genome routes)
    rfcount_img                = false  // generate R coverage plots per transcript (-g); slow on large transcriptomes
    rfcount_trim_5prime        = 0
    rfcount_mask_file          = null
    rfcount_primary_only       = false
    rfcount_paired_only        = false
    rfcount_properly_paired    = false
    rfcount_map_sort_by_read_name = true  // MaP only; only applied for paired-end reads regardless of this value
    rfcount_map_discard_shorter   = 1
    rfcount_map_min_quality       = 20
    rfcount_map_collapse_consecutive = null  // MaP only: null = auto (ON unless RT_enzyme is Group II Intron/TGIRT)
    rfcount_map_max_collapse_distance = 2

    // RNAframework rf-count-genome options (genome route only)
    rfcount_strandedness          = 'unstranded'  // auto-detected per sample via RSeQC; override if known
    rfcount_genome_map_quality    = 0             // minimum MAPQ to include a read (-mq); raise to filter multi-mappers
    rfcount_genome_block_size     = 100000        // block size for per-chromosome memory allocation (-bs); increase for large genomes
    rfcount_genome_samtools_threads = 1           // SAMtools working threads per processor instance (-wt); total = -p × -wt
    rfcount_map_median_quality    = 20            // MaP only: discard reads below this median Phred+33 quality (-eq)
    rfcount_map_no_deletions              = false  // MaP only: ignore all deletion events (-nd)
    rfcount_map_no_ambiguous              = null   // MaP only: ignore ambiguously aligned deletions (-na); null = auto (off for M-MLV, on for Group II Intron/TGIRT)
    rfcount_map_no_insertions             = null   // MaP only: ignore insertion events (-ni); null = auto (off for M-MLV, on for Group II Intron/TGIRT)
    rfcount_map_right_deletion            = null   // MaP only: mark only right-most base of a deletion as mutated (--right-deletion); null = auto (on for M-MLV, off for Group II Intron/TGIRT)
    rfcount_map_discard_consecutive       = null   // MaP only: discard mutations within N nt (-dc N); null = auto (3 for Group II Intron/TGIRT, off for M-MLV)
    rfcount_map_eval_surrounding  = true          // MaP only: also evaluate quality of ±1 nt surrounding each mutation (-es); recommended for all MaP experiments
    rfcount_discard_clipped_reads = false         // discard reads with excessive 5'/3' end clipping (-dp); added in RNAFramework 2.9.7

    // RNAframework rf-norm options
    rfnorm_remap_reactivities   = false
    rfnorm_reactive_bases       = null
    rfnorm_norm_window          = null          // null = auto (50 for DMS or RT-stop, unset otherwise)
    rfnorm_window_offset        = null
    rfnorm_dynamic_window       = null
    rfnorm_norm_independent     = false
    rfnorm_use_normfactor       = null          // cross-experiment normalisation via rf-normfactor (one factor set per reference, fed to rf-norm via -nf). null=auto (on for a reference with paired untreated controls or >1 treated sample), true=force on, false=force off (per-sample box-plot).
    rfnorm_normfactor_min_coverage = null       // rf-normfactor -mc: bases below this coverage are excluded from the factor calculation; null = auto (1000 for MaP, 50 for RT-stop)
    rfnorm_score_method         = null          // override scoring method: 1=Ding, 2=Rouskin, 3=Siegfried, 4=Zubradt
    rfnorm_norm_method          = null          // override normalisation method: 2=90% Winsorizing, 3=Box-plot (default), 4=Mitchell (MaP only, added in RNAFramework 2.9.4)
    rfnorm_raw                  = false
    rfnorm_pseudocount          = null
    rfnorm_ignore_lower_than_untreated = false
    rfnorm_mean_coverage        = 0
    rfnorm_median_coverage      = 0
    rfnorm_nan                  = null          // minimum per-position coverage below which reactivity is set to NaN (-n); null = auto (1000 for MaP, 50 for RT-stop)
    rfnorm_prefilter_min_coverage = 1           // drop transcripts with no base at coverage >= this value after rf-rctools extract (genome route); set to 0 to keep the full annotation RC
    rfnorm_img                  = false  // generate R reactivity plots per transcript (-g); slow on large transcriptomes

       // Jackknife
    jackknife_reference        = null  // Optional path to reference structures for rf-jackknife quality assessment
    rfjackknife_slope          = '0,5'   // comma-separated slope range to search (-sl)
    rfjackknife_intercept      = '-3,0'  // comma-separated intercept range to search (-in)
    rfjackknife_slope_step     = 0.2     // step size for slope grid search (-ss)
    rfjackknife_intercept_step = 0.2     // step size for intercept grid search (-is)
    rfjackknife_mfmi                = true   // use modified FMI (-m); used in Zubradt et al. 2025 NBT
    rfjackknife_relaxed             = true   // use relaxed FMI criteria (-x); used in Zubradt et al. 2025 NBT
    rfjackknife_keep_lonelypairs    = true   // keep lonely base-pairs (1bp helices) in reference structure (-kl); author's current default
    rfjackknife_keep_pseudoknots    = false  // exclude pseudoknotted base-pairs from FMI comparison; rf-fold cannot predict pseudoknots so including them systematically lowers FMI
    rfjackknife_only_common         = false  // only use transcripts present across all replicates (-oc)
    rfjackknife_img                 = false  // generate R heatmap of grid-search results (-g)
    rfjackknife_rf_fold_params      = '-md 600'  // additional rf-fold parameters passed inside jackknife (-rp)
    rfjackknife_pool_all            = true   // pool XMLs from all sample groups into a single jackknife run; set false to run one jackknife per group
    stop_after_jackknife            = false  // stop pipeline after jackknife; skip rf-fold, visualise, browser tracks, and RDAT generation

    // RNAframework rf-fold options
    rffold_img                        = false  // generate ViennaRNA RNAplot structure diagrams via rf-fold (-g); slow on large transcriptomes
    rffold_ct                  = false
    rffold_window              = 1000  // enables windowed MFE folding with this window size (-w -fw N); null = whole-transcript folding
    rffold_partition_window    = 1000  // partition-function window size (-pw N)
    rffold_unconstrained       = false
    rffold_vienna_no_lonely_pairs = false
    rffold_vienna_constrained  = false
    rffold_vienna_max_bp_span  = 600
    rffold_vienna_bp_span      = null
    rffold_only_common         = null
    rffold_fold_constraint_file = null
    rffold_unpaired_constraint_file = null
    rffold_dotplot             = true
    rffold_shannon_entropy     = true
    rffold_vienna_rnaplot      = 'RNAplot'
    rffold_slope               = null  // null = auto by meta.chemical (DMS 4.6, NAI 2.2, 2A3 1, other/unset 1.8); overridden by jackknife when available
    rffold_intercept           = null  // null = auto by meta.chemical (DMS -2, NAI -0.8, 2A3 -0.4, other/unset -0.6); overridden by jackknife when available
    r2dt                       = true
    r2dt_templatable_biotypes  = 'rRNA,Mt_rRNA,tRNA,Mt_tRNA,snoRNA,scaRNA,snRNA,SRP_RNA,RNase_P_RNA,RNase_MRP_RNA,tmRNA' // only these GTF biotypes are sent to R2DT (it has no mRNA/lncRNA templates and would force-fit them); others are drawn by ViennaRNA
    rfwiggle_report_zeroes     = true // report 0 instead of null for bases with no coverage as this is expected by genome browsers
    rfwiggle_keep_bases        = null
    rnaframework_r_path        = '/usr/bin/R'

    // RNAframework rf-rctools options
    rfrctools_gtf_feature      = 'exon'          // GTF feature type to extract (-f); override for non-standard annotations
    rfrctools_gtf_attribute    = 'transcript_id'  // GTF attribute used as the output RC entry ID (-b)

    // RNAframework rf-eval options
    rfeval_reference           = null  // path to a .db file of known structures; enables rf-eval when set
    rfeval_windows             = null  // optional manifest (ref_seq_id start end structure_id [strand]) slicing XML reactivities to sub-region references before rf-eval
    rfeval_reactivity_cutoff   = 0.7   // cutoff for classifying a base as highly-reactive in unpaired-coefficient calculation (-c)
    rfeval_ignore_terminal     = true   // exclude terminal base-pairs from calculations (-it)
    rfeval_terminal_as_unpaired = false // treat terminal base-pairs as unpaired (-tu)
    rfeval_keep_pseudoknots    = true   // retain pseudoknotted base-pairs (-kp)
    rfeval_keep_lonelypairs    = true   // retain lonely/isolated base-pairs (-kl)
    rfeval_img                 = false  // generate R metric plots (-g)

    // RNAframework rf-structextract options (extract high-confidence, low-reactivity/low-Shannon motifs from rf-fold output)
    structextract                   = false  // enable rf-structextract after rf-fold
    structextract_win_size          = 50     // window size (nt) for median reactivity/Shannon (-w)
    structextract_min_transcript_len = 500   // skip low-reactivity/low-Shannon evaluation below this transcript length (-ml)
    structextract_min_value_frac    = 0.4    // windows with less than this fraction of bases covered are set to NaN (-mv)
    structextract_min_below_median  = 0.7    // min fraction of bases with Shannon+reactivity below the transcript median (-mb)
    structextract_min_paired_frac   = 0.45   // discard elements with less than this fraction of paired bases (-mp)
    structextract_min_motif_len     = 50     // discard structure elements shorter than this (-mm)
    structextract_max_motif_len     = null   // discard structure elements longer than this (-xm); null = no limit
    structextract_max_loop_size     = null   // discard elements with a loop larger than this (-xl); null = no limit
    structextract_ignore_react      = false  // evaluate reactivity so only regions with probing support are extracted (-ir when true)
    structextract_ignore_shannon    = false  // evaluate low-Shannon so only high-confidence regions are extracted (-is when true)
    structextract_multiway_only     = false  // only report elements encompassing multiway junctions (-mo)
    structextract_one_per_file      = false  // report each extracted element in a separate file (-opf)
    structextract_eval_energy       = false  // only report elements with significantly low free energy (-ee)
    structextract_pvalue            = 0.05   // p-value threshold for energy significance (-v); requires structextract_eval_energy
    structextract_n_shufflings      = 100    // number of sequence shufflings for energy evaluation (-ns)
    structextract_dinucl_shuffle    = false  // preserve dinucleotide frequencies when shuffling (-ds)
    structextract_plot              = true   // render an SVG diagram per extracted motif via ViennaRNA RNAplot

    // RNAframework rf-correlate options (replicate-reproducibility QC: pairwise reactivity correlation)
    correlate_replicates       = true   // run rf-correlate for sample_groups with >1 replicate (no-op otherwise); surfaced in MultiQC
    rfcorrelate_cap_react      = 1.5    // cap reactivities to this value before Pearson correlation (-cr); not applied to Spearman
    correlate_min_values       = null   // minimum number of values to calculate correlation (-m); fraction of transcript length if 0<x<1
    correlate_ignore_sequence  = false  // ignore sequence differences (e.g. SNVs) between compared transcripts (-I)
    correlate_img              = false  // generate the rf-correlate correlation heatmap PDF (-g); requires R

    // References
    ensembl_base_url           = 'https://ftp.ensembl.org/pub'
    ensembl_release            = 'current'
    ensembl_species_map        = [
        'human'   : 'homo_sapiens',
        'mouse'   : 'mus_musculus',
        'yeast'   : 'saccharomyces_cerevisiae',
        'rat'     : 'rattus_norvegicus'
    ]
    ncbi_accessions_map        = [:]

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // SLURM executor options (used by the `slurm` profile; ignored otherwise)
    slurm_queue                = null
    slurm_account              = null
    slurm_clusterOptions       = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Curated NCBI accession lists for viral organisms — loaded automatically
includeConfig 'conf/viral_genomes.config'
includeConfig 'conf/bacterial_genomes.config'

profiles {
    debug {
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
        // On macOS arm64, force osx-64 packages (Rosetta 2) so bioconda tools like rnaframework
        // resolve correctly, via conda.createOptions --platform passed directly to `conda create`.
        conda.createOptions     = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '--platform osx-64' : ''
        env.CONDA_SUBDIR        = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? 'osx-64' : null
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
            r2dt                  = false
        }
        process {
            resourceLimits = [
                cpus: 4,
                memory: '15.GB',
                time: '1.h'
            ]
            withName: 'CAT_FASTQ' {
                // lbzip2 is Linux-only and sed=4.8 has no osx-64 build; inline spec drops
                // lbzip2 and leaves sed unpinned on macOS (sed is only used for version parsing)
                conda = System.getProperty('os.name')?.contains('Mac') ? 'conda-forge::coreutils=9.5 conda-forge::grep=3.11 conda-forge::gzip=1.13 conda-forge::sed conda-forge::tar=1.34' : null
            }
            // On macOS arm64 switch from YAML-based to inline conda specs so conda.createOptions
            // (--platform osx-64) is honoured (conda env create ignores it; conda create doesn't).
            // beforeScript ensures the conda env's Perl precedes any system Perl on PATH.
            withName: 'RNAFRAMEWORK_RFCOUNT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFNORMFACTOR' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFSTRUCTEXTRACT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFCORRELATE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFCOUNT_GENOME' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFRCTOOLS_EXTRACT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFJACKKNIFE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFEVAL' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFNORM' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFFOLD' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7 bioconda::viennarna=2.7.2 conda-forge::perl' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFWIGGLE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7 bioconda::ucsc-bedgraphtobigwig' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            // STAR environment.yml uses YAML-based env creation which ignores conda.createOptions
            // (--platform osx-64) on macOS arm64. Override to inline spec so Rosetta 2 is used.
            withName: 'STAR_GENOMEGENERATE|STAR_ALIGN_RTSTOP|STAR_ALIGN_MAP' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::star=2.7.11b bioconda::samtools=1.21 bioconda::htslib=1.21 conda-forge::gawk=5.1.0' : null
            }
        }
    }
    mamba {
        // Users running this profile need `mamba` installed and available on PATH.
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        conda.createOptions     = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '--platform osx-64' : ''
        env.CONDA_SUBDIR        = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? 'osx-64' : null
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
            r2dt                  = false
        }
        process {
            resourceLimits = [
                cpus: 4,
                memory: '15.GB',
                time: '1.h'
            ]
            withName: 'CAT_FASTQ' {
                // lbzip2 is Linux-only and sed=4.8 has no osx-64 build; inline spec drops
                // lbzip2 and leaves sed unpinned on macOS (sed is only used for version parsing)
                conda = System.getProperty('os.name')?.contains('Mac') ? 'conda-forge::coreutils=9.5 conda-forge::grep=3.11 conda-forge::gzip=1.13 conda-forge::sed conda-forge::tar=1.34' : null
            }
            // On macOS arm64 switch from YAML-based to inline conda specs so conda.createOptions
            // (--platform osx-64) is honoured (conda env create ignores it; conda create doesn't).
            // beforeScript ensures the conda env's Perl precedes any system Perl on PATH.
            withName: 'RNAFRAMEWORK_RFCOUNT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFNORMFACTOR' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFSTRUCTEXTRACT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFCORRELATE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFCOUNT_GENOME' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFRCTOOLS_EXTRACT' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFJACKKNIFE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFEVAL' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFNORM' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFFOLD' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7 bioconda::viennarna=2.7.2 conda-forge::perl' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'RNAFRAMEWORK_RFWIGGLE' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.7 bioconda::ucsc-bedgraphtobigwig' : null
                beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
            }
            withName: 'STAR_GENOMEGENERATE|STAR_ALIGN_RTSTOP|STAR_ALIGN_MAP' {
                conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::star=2.7.11b bioconda::samtools=1.21 bioconda::htslib=1.21 conda-forge::gawk=5.1.0' : null
            }
        }
    }
    docker {
        docker.enabled          = true
        conda.enabled           = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '-u $(id -u):$(id -g) --platform linux/amd64' : '-u $(id -u):$(id -g)'
        process.arch            = null
        apptainer.ociAutoPull   = false
        singularity.ociAutoPull = false
        wave.enabled            = false
        wave.freeze             = false
        wave.strategy           = null
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
        }
        process {
            withName: '.*' {
                // Disable conda for all processes so Docker is always used.
                // conda.enabled is still true on ARM64 to allow the MULTIQC exception below.
                conda = null
            }
            withName: '(^|.*:)MULTIQC$' {
                // MultiQC segfaults under Docker/qemu on Apple Silicon, so run it from conda there.
                // On amd64 (e.g. CI) use the module's Docker container as normal.
                container = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? null : 'community.wave.seqera.io/library/multiqc:1.35--c17fb751507e9dfc'
                conda     = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? "${projectDir}/modules/nf-core/multiqc/environment.yml" : null
            }
        }
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694 — arm64 currently requires wave
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        params {
            rnaframework_r_path    = '$(command -v R)'
            rffold_vienna_rnaplot = '$(command -v RNAplot)'
        }
        // Per-process resources live in conf/modules.config (applies to every engine) — keep
        // this profile to container settings only.
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }

    test              { includeConfig 'conf/test.config'              }
    test_transcriptome { includeConfig 'conf/test_transcriptome.config' }
    test_prokaryote   { includeConfig 'conf/test_prokaryote.config'   }
    test_full         { includeConfig 'conf/test_full.config'         }

    slurm {
        // Generic SLURM profile: `-profile slurm,<container>` with optional --slurm_queue / --slurm_account /
        // --slurm_clusterOptions. Unset flags omit the directive and fall back to cluster defaults.
        executor {
            name            = 'slurm'
            queueSize       = 100
            submitRateLimit = '1sec'
            exitReadTimeout = '30 min'
        }
        process {
            scratch        = true
            queue          = { params.slurm_queue }
            clusterOptions = {
                def opts = []
                if (params.slurm_account)        opts << "--account=${params.slurm_account}"
                if (params.slurm_clusterOptions) opts << params.slurm_clusterOptions
                opts ? opts.join(' ') : null
            }
        }
    }

    codon {
        // EBI Codon cluster. Self-contained (`-profile codon,singularity` works with no extra flags) but
        // composes with `slurm`: `-profile slurm,codon` keeps its queue/queueSize plus CLI --slurm_* flags.
        params {
            config_profile_name        = 'codon'
            config_profile_description = 'EBI Codon SLURM cluster profile'
        }
        executor {
            name            = 'slurm'
            queueSize       = 2000       // EBI Codon allows aggressive queue saturation
            submitRateLimit = '1sec'
            exitReadTimeout = '30 min'
        }
        process {
            scratch = true
            queue   = 'production'
        }
    }
}

// Load nf-core custom profiles from different institutions. Included if params.custom_config_base is set
// and either NXF_OFFLINE is unset or the base is a local path.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile.
// Only used if one of those engines is enabled; set to your own registry if you have a mirror.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container.
// JULIA_DEPOT_PATH is fixed to /usr/local/share/julia; see https://apeltzer.github.io/post/03-julia-lang-nextflow/

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${(params.outdir as String) ?: 'results'}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
    overwrite = true
}

    manifest {
        name            = 'nf-core/rnastructurome'
        contributors    = [
            [
                name: 'Victoria Begley',
                affiliation: 'EMBL-EBI',
                email: 'begley@ebi.ac.uk',
                github: 'Vicbeg',
                contribution: ['author'],
                orcid: '0000-0001-9000-7051'
            ],
            [
                name: 'Pedro Madrigal',
                affiliation: 'EMBL-EBI',
                email: 'pmadrigal@ebi.ac.uk',
                github: 'pmb59',
                contribution: ['author'],
                orcid: '0000-0003-1959-8199'
            ] // Add more contributors here as needed
        ]
    homePage        = 'https://github.com/nf-core/rnastructurome'
    description     = """This pipeline analyses chemical-based high-throughput RNA structure probing data"""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.2' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// EBI Codon-specific resource overrides must be loaded after module defaults.
includeConfig params.config_profile_name == 'codon' ? 'conf/codon.config' : '/dev/null'

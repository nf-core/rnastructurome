                gtf    = "$projectDir/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz"
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'main_rtstop_r1', sample_id:'main_rtstop_r1', principle:'RT-stop', organism:'Homo sapiens', single_end:true, sample_group:'main_line', replicate:'rep1', condition:'treated' ],
                        [ file(params.pipelines_testdata_base_path + 'rnastructurome/testdata/HEK293T_untreated_r1.fastq.gz', checkIfExists: true) ]
                    ],
                    [
                        [ id:'main_rtstop_r2', sample_id:'main_rtstop_r2', principle:'RT-stop', organism:'Homo sapiens', single_end:true, sample_group:'main_line', replicate:'rep2', condition:'treated' ],
                        [ file(params.pipelines_testdata_base_path + 'rnastructurome/testdata/HEK293T_untreated_r1.fastq.gz', checkIfExists: true) ]
                    ]
                )

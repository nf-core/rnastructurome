    }

    test("Runs with cross-experiment rf-normfactor normalisation enabled") {

        options "-stub"

        when {
            params {
                outdir                = "$outputDir"
                fasta                 = "https://raw.githubusercontent.com/nf-core/test-datasets/rnastructurome/testdata/test_transcriptome/Homo_sapiens.GRCh38.ENST00000389680.fa"
                gtf                   = "$projectDir/modules/local/ensembl/gtf/tests/fixtures/ensembl/pub/current_gtf/homo_sapiens/Homo_sapiens.test.115.gtf.gz"
                rfnorm_use_normfactor = true
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'main_rtstop', sample_id:'main_rtstop', principle:'RT-stop', organism:'Homo sapiens', single_end:true, sample_group:'main_line', replicate:'rep1', condition:'treated' ],
                        [ file(params.pipelines_testdata_base_path + 'rnastructurome/testdata/HEK293T_untreated_r1.fastq.gz', checkIfExists: true) ]
                    ]
                )
                input[1] = false
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // rf-normfactor only runs when --rfnorm_use_normfactor is set; its presence in the
                // collated versions confirms the cross-experiment branch executed.
                { assert path("${outputDir}/pipeline_info/nf_core_rnastructurome_software_mqc_versions.yml").text.contains('RNAFRAMEWORK_RFNORMFACTOR') }
            )
        }
    }


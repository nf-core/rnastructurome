/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EBI Codon SLURM profile overrides
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Keep Codon-specific resource tuning here so generic container and module defaults
    remain portable for other clusters.
----------------------------------------------------------------------------------------
*/

process {
    // FASTQC: uses ~2 threads (JVM multi-thread overhead); keep memory high for JVM heap
    withName: 'FASTQC_PRE|FASTQC_POST' {
        cpus   = 2
        memory = { 36.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'UMITOOLS_DEDUP' {
        cpus   = 1
        memory = { 48.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withName: BOWTIE_ALIGN {
        cpus       = 24
        memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
        time       = { 16.h * task.attempt }
        maxRetries = 2
    }

    withName: BOWTIE2_ALIGN {
        cpus       = 24
        memory     = { (params.bowtie_all ? 128.GB : 36.GB) * task.attempt }
        time       = { 16.h * task.attempt }
        maxRetries = 2
    }

    withName: 'STAR_ALIGN_MAP|STAR_ALIGN_RTSTOP' {
        cpus       = 12
        memory     = { 96.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        maxRetries = 2
    }

    // SAMTOOLS_SORT_NAME / coordinate SORT: ~4 CPUs, ~5 GB RSS observed
    withName: 'SAMTOOLS_SORT_NAME|SAMTOOLS_SORT' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // SAMTOOLS_VIEW filters the full multimapper transcriptome BAM by qname-file; the module
    // wires --threads (task.cpus - 1), so process_low's 2 CPUs leave it single-threaded.
    withName: SAMTOOLS_VIEW {
        cpus = 8
        time = { 8.h * task.attempt }
    }

    // SAMTOOLS_QNAMES: single-threaded `samtools view | sort -u` over the full multimapper BAM.
    // Threads feed samtools -@ and the sort -S buffer is sized from this memory request.
    withName: SAMTOOLS_QNAMES {
        cpus   = 8
        memory = { 24.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    // SAMTOOLS_SORT_TRANSCRIPT sorts STAR TranscriptomeSAM BAMs, which can be much larger
    // than coordinate BAMs when multimappers are retained.
    withName: SAMTOOLS_SORT_TRANSCRIPT {
        cpus       = 8
        memory     = { 48.GB * task.attempt }
        time       = { 8.h  * task.attempt }
        maxRetries = 2
    }

    // SAMTOOLS_MARKDUP: ~2 CPUs but up to 131 GB RSS observed — increase base memory
    withName: SAMTOOLS_MARKDUP {
        cpus       = 4
        memory     = { 160.GB * task.attempt }
        maxRetries = 2
    }

    withName: 'RNAFRAMEWORK_RFCOUNT_GENOME' {
        cpus   = 12
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'RNAFRAMEWORK_RFCOUNT_STAR|RNAFRAMEWORK_RFCOUNT' {
        cpus   = 60
        memory = { 72.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    // RFNORMFACTOR runs the same rf-norm engine (-p task.cpus) as RFNORM, so it needs the same CPUs —
    // without this it fell back to process_medium's 6 CPUs and crawled.
    withName: 'RNAFRAMEWORK_RFNORMFACTOR' {
        cpus       = 60
        memory     = { 72.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        maxRetries = 2
    }

    // RFNORM: ~55 CPUs (-p task.cpus), ~21 GB RSS observed
    withName: 'RNAFRAMEWORK_RFNORM' {
        cpus       = 60
        memory     = { 32.GB * task.attempt }
        time       = { 8.h   * task.attempt }
        maxRetries = 2
    }

    // RFFOLD: ~51 CPUs (-p task.cpus), ~3.7 GB RSS observed (vmem is high due to ViennaRNA)
    withName: 'RNAFRAMEWORK_RFFOLD' {
        cpus   = 60
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // RFJACKKNIFE: scans slope/intercept grid (-p task.cpus); scales with transcript count
    withName: 'RNAFRAMEWORK_RFJACKKNIFE' {
        cpus   = 60
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: 'MERGE_BP' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'MERGE_BP_TRANSCRIPT' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'AVERAGE_WIG' {
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: 'MULTIQC' {
        memory     = { 32.GB * task.attempt }
        time       = { 8.h  * task.attempt }
        maxRetries = 2
    }

    // R2DT: cmscan/Infernal over per-transcript inputs; process_single's 6 GB is tight at high
    // transcript counts. r2dt.py manages its own subprocesses, so bump memory (not cpus).
    withName: 'R2DT' {
        memory     = { 24.GB * task.attempt }
        maxRetries = 2
    }

    withName: 'VIENNARNA' {
        cpus = 12
    }
}

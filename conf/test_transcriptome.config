/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running transcriptome-mode (Bowtie) tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises the --transcriptome route using a single-transcript FASTA
    (ENST00000389680.2, MT-RNR1) so rf-count RC files and rf-fold dot-plots are
    named with a real GTF transcript_id, enabling genome-coordinate BigWig and
    .bp arc conversion to be fully tested.

    Data is pulled from nf-core/test-datasets (rnastructurome branch):
        testdata/test_transcriptome/Homo_sapiens.GRCh38.ENST00000389680.fa  — transcript FASTA
        testdata/test_transcriptome/Homo_sapiens.GRCh38.MT.gtf              — MT GTF (contains ENST00000389680)

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test_transcriptome,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test transcriptome profile'
    config_profile_description = 'Single-transcript (ENST00000389680 / MT-RNR1) test dataset to check pipeline function (Bowtie transcriptome route)'

    input        = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_transcriptome/samplesheet.transcriptome_test.csv'

    principle    = 'RT-stop'
    fasta        = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_transcriptome/Homo_sapiens.GRCh38.ENST00000389680.fa'
    gtf          = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_transcriptome/Homo_sapiens.GRCh38.MT.gtf'
    transcriptome = true
    rfnorm_raw   = true  // skip normalisation so rf-fold still runs on tiny test data
    rfnorm_nan   = 0     // disable NaN masking; test reads are too few to meet the default threshold
    structextract = true // exercise rf-structextract on the folded single transcript (954 nt > minTranscriptLen)
    // Loosen the reactivity/Shannon filters (but keep them active, not --ignore) so the tiny test
    // data still yields motifs: too few reads to pass the default below-median/coverage thresholds.
    structextract_min_value_frac   = 0.0 // don't NaN-mask low-coverage windows (default 0.4)
    structextract_min_below_median = 0.0 // accept any below-median fraction (default 0.7)
    structextract_min_motif_len    = 20  // shorter motifs on the small test transcript (default 50)
}

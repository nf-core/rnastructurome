/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Uses the human mitochondrial chromosome (16,569 bp) as the reference genome so
    that the full STAR genome-alignment route is exercised on tiny test data.
    Test reads are from ENST00000389680 (MT-RNR1, MT:648-1601).

    Data is pulled from nf-core/test-datasets (rnastructurome branch). Local helper
    scripts in tmp/ were used to originally generate these tiny references and reads.

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // MT chromosome is 16,569 bp; STAR needs a reduced SA index for small genomes.
    // Formula: floor(log2(genomeLength) / 2) - 1 = floor(14.01 / 2) - 1 = 6
    withName: 'STAR_GENOMEGENERATE' {
        ext.args = '--genomeSAindexNbases 6'
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Human mitochondrial chromosome test dataset to check pipeline function (STAR route)'

    // Input — synthetic reads from the MT RNR1 region, guaranteed to map to the MT genome.
    input        = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_genome/samplesheet.genome_test.csv'

    principle    = 'RT-stop'
    fasta        = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_genome/Homo_sapiens.GRCh38.MT.fa'
    gtf          = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_genome/Homo_sapiens.GRCh38.MT.gtf'
    // MT genes have no introns, so STAR's --quantMode TranscriptomeSAM (default count_genome=false)
    // hits an intermittent STAR bug here; use the legacy rf-count-genome route for this intron-less reference.
    count_genome = true
    rfnorm_raw   = true  // skip normalisation so rf-fold still runs on tiny test data
    rfnorm_nan   = 0     // disable NaN masking; test reads are too few to meet the default threshold
    rfnorm_prefilter_min_coverage = 2 // drop the single-base MT boundary artefact in this tiny test without changing full-size runs
}

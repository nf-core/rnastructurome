/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'FASTQC_POST' {
        ext.prefix = { "${meta.id}_trimmed" }
    }

    withName: CUTADAPT_RTSTOP {
        ext.args = {
            def adapter_5p = meta.adapter_5p ?: params.cutadapt_adapter_5p
            def adapter_3p = meta.adapter_3p ?: params.cutadapt_adapter_3p
            def quality_only = params.cutadapt_quality_only
            def q3 = params.cutadapt_3quality as Integer
            def min_len = params.cutadapt_len as Integer
            def min_align = params.cutadapt_min_align as Integer
            def trim_n = params.cutadapt_trim_n as Boolean
            def nextseq_trim = params.cutadapt_nextseq_trim ? "--nextseq-trim=${params.cutadapt_nextseq_trim as Integer}" : ''
            def discard_untrimmed = params.cutadapt_discard_untrimmed ? '--discard-untrimmed' : ''
            def base_complement = ['A':'T', 'C':'G', 'G':'C', 'T':'A', 'N':'N']
            def args = []
            if (!quality_only) {
                (adapter_5p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    def revcomp_seq = seq.toUpperCase().reverse().collect { nt -> base_complement[nt] ?: 'N' }.join('')
                    args << "-g ${revcomp_seq}"
                    if (!meta.single_end) {
                        args << "-G ${revcomp_seq}"
                    }
                }
                (adapter_3p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    args << "-a ${seq}"
                    if (!meta.single_end) {
                        args << "-A ${seq}"
                    }
                }
            }
            def pair_filter = meta.single_end ? '' : '--pair-filter=any'
            def trim_n_arg = trim_n ? '--trim-n' : ''
            "${args.join(' ')} -q 0,${q3} -m ${min_len} ${trim_n_arg} -O ${min_align} ${pair_filter} ${nextseq_trim} ${discard_untrimmed}".trim()
        }
    }

    withName: CUTADAPT_MAP {
        ext.args = {
            def adapter_5p = meta.adapter_5p ?: params.cutadapt_adapter_5p
            def adapter_3p = meta.adapter_3p ?: params.cutadapt_adapter_3p
            def quality_only = params.cutadapt_quality_only
            def q5 = params.cutadapt_5quality as Integer
            def q3 = params.cutadapt_3quality as Integer
            def min_len = params.cutadapt_len as Integer
            def min_align = params.cutadapt_min_align as Integer
            def trim_n = params.cutadapt_trim_n as Boolean
            def nextseq_trim = params.cutadapt_nextseq_trim ? "--nextseq-trim=${params.cutadapt_nextseq_trim as Integer}" : ''
            def discard_untrimmed = params.cutadapt_discard_untrimmed ? '--discard-untrimmed' : ''
            def base_complement = ['A':'T', 'C':'G', 'G':'C', 'T':'A', 'N':'N']
            def args = []
            if (!quality_only) {
                (adapter_5p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    def revcomp_seq = seq.toUpperCase().reverse().collect { nt -> base_complement[nt] ?: 'N' }.join('')
                    args << "-g ${revcomp_seq}"
                    if (!meta.single_end) {
                        args << "-G ${revcomp_seq}"
                    }
                }
                (adapter_3p ?: '').toString().tokenize(',').collect { adapter -> adapter.trim() }.findAll { adapter -> adapter }.each { seq ->
                    args << "-a ${seq}"
                    if (!meta.single_end) {
                        args << "-A ${seq}"
                    }
                }
            }
            def pair_filter = meta.single_end ? '' : '--pair-filter=any'
            def trim_n_arg = trim_n ? '--trim-n' : ''
            "${args.join(' ')} -q ${q5},${q3} -m ${min_len} ${trim_n_arg} -O ${min_align} ${pair_filter} ${nextseq_trim} ${discard_untrimmed}".trim()
        }
    }

    withName: UMITOOLS_EXTRACT {
        ext.when = { (meta.umi_pattern ?: '').toString().trim() ? true : false }
        ext.args = {
            def umi_pattern = (meta.umi_pattern ?: params.umi_pattern ?: '').toString().trim().toUpperCase()
            def iupac_map = [
                'A':'A', 'C':'C', 'G':'G', 'T':'T', 'R':'[AG]', 'Y':'[CT]', 'S':'[GC]',
                'W':'[AT]', 'K':'[GT]', 'M':'[AC]', 'B':'[CGT]', 'D':'[AGT]', 'H':'[ACT]',
                'V':'[ACG]', 'N':'[ACGT]', 'X':'[ACGT]'
            ]
            if (!umi_pattern) {
                return ''
            }
            if (umi_pattern ==~ /[NCX]+/) {
                return "--bc-pattern=${umi_pattern}"
            }
            def invalid_chars = umi_pattern.collect { nt -> nt as String }.findAll { nt -> !iupac_map.containsKey(nt) }.unique()
            if (invalid_chars) {
                error("Unsupported umi_pattern '${umi_pattern}' for sample '${meta.id}'. Unsupported character(s): ${invalid_chars.join(', ')}")
            }
            def regex_pattern = umi_pattern.collect { nt -> iupac_map[nt as String] }.join('')
            "--extract-method=regex --bc-pattern=\"^(?P<umi_1>${regex_pattern})\""
        }
    }

    withName: 'BEDOPS_GTF2BED' {
        publishDir = [ enabled: false ]
    }

    withName: 'STAR_GENOMEGENERATE' {
        ext.args = { "--sjdbOverhang ${params.star_map_sjdb_overhang}" }
    }

    withName: 'STAR_ALIGN_RTSTOP' {
        // No node-local scratch: the genome+transcriptome BAMs overflow the compute node's
        // local scratch ($TMPDIR) with ENOSPC; write straight to the work dir instead.
        scratch = false
        ext.args = {
            def args = [
                '--readFilesCommand "gunzip -c"',
                "--outFilterMultimapNmax ${params.star_multimap_nmax as Integer}",
                '--alignSJoverhangMin 8',
                '--alignSJDBoverhangMin 2',
                '--outFilterMismatchNmax 999',
                '--outFilterMismatchNoverReadLmax 0.04',
                '--alignIntronMin 20',
                '--alignIntronMax 1000000',
                '--alignMatesGapMax 1000000',
                '--alignEndsType Extend5pOfRead1',
                '--outFilterScoreMinOverLread 0.15',
                '--outFilterMatchNminOverLread 0.15',
                '--outSAMattributes NH HI AS NM MD',
            ]
            // TranscriptomeSAM feeds the default genome-route counting path (calmd + rf-count);
            // skip it when the legacy rf-count-genome + rf-rctools extract path is selected.
            if (!params.transcriptome && !params.count_genome) {
                args << '--quantMode TranscriptomeSAM'
            }
            args.join(' ')
        }
    }

    withName: 'STAR_ALIGN_MAP' {
        // No node-local scratch: AllBestScore multimappers make the genome+transcriptome BAMs
        // huge and fill the compute node's local scratch ($TMPDIR) with ENOSPC.
        scratch = false
        ext.args = {
            def args = [
                '--readFilesCommand "gunzip -c"',
                "--outFilterMultimapNmax ${params.star_multimap_nmax as Integer}",
                '--alignSJoverhangMin 8',
                '--alignSJDBoverhangMin 2',
                '--outFilterMismatchNmax 999',
                '--outFilterMismatchNoverReadLmax 0.15',
                '--alignIntronMin 20',
                '--alignIntronMax 1000000',
                '--alignMatesGapMax 1000000',
                '--alignEndsType Local',
                '--outFilterScoreMinOverLread 0.15',
                '--outFilterMatchNminOverLread 0.15',
                '--outSAMprimaryFlag AllBestScore',
                '--outSAMattributes All',
                "--sjdbOverhang ${params.star_map_sjdb_overhang}",
            ]
            if (!params.transcriptome && !params.count_genome) {
                args << '--quantMode TranscriptomeSAM'
            }
            args.join(' ')
        }
    }

    withName: BOWTIE_ALIGN {
        ext.args = {
            def args = []
            if (params.bowtie_all as Boolean) {
                args << '-a'
            } else if (params.bowtie_k != null) {
                args << "-k ${params.bowtie_k as Integer}"
            }
            if ((params.bowtie_trim5 as Integer) > 0) {
                args << "--trim5 ${params.bowtie_trim5 as Integer}"
            }
            if ((params.bowtie_trim3 as Integer) > 0) {
                args << "--trim3 ${params.bowtie_trim3 as Integer}"
            }
            args << '-l 28'
            if (params.bowtie_v != null) {
                args << "-v ${params.bowtie_v as Integer}"
            } else {
                args << "-n ${params.bowtie_n as Integer}"
            }
            if (!(params.bowtie_all as Boolean) && params.bowtie_k == null) {
                if (params.bowtie_max != null) {
                    args << "-m ${params.bowtie_max as Integer}"
                    // -m alone reports just one alignment per multi-mapper; -a reports all of them
                    // (still capped/discarded by -m when a read exceeds bowtie_max alignments).
                    if ((params.bowtie_max as Integer) > 1) {
                        args << '-a'
                    }
                }
            }
            args << '--best'
            args << '--strata'
            args << "--chunkmbs ${params.bowtie_chunkmbs as Integer}"
            args.join(' ').trim()
        }
    }

    withName: BOWTIE2_ALIGN {
        ext.args = {
            def args = []
            def preset = params.bowtie2_preset?.toString()?.trim() ?: ''
            // bowtie_all (-a) is applied regardless of preset; -a and a preset's seed-search
            // parameters are orthogonal in bowtie2 (the preset doesn't restrict reporting to one
            // alignment), so both apply together.
            if (params.bowtie_all as Boolean) {
                args << '-a'
            } else if (!preset && params.bowtie_k != null) {
                args << "-k ${params.bowtie_k as Integer}"
            }
            if ((params.bowtie_trim5 as Integer) > 0) {
                args << "--trim5 ${params.bowtie_trim5 as Integer}"
            }
            if ((params.bowtie_trim3 as Integer) > 0) {
                args << "--trim3 ${params.bowtie_trim3 as Integer}"
            }
            if (preset) {
                args << preset
                // --local is implied by *-local presets; softclip match bonus still applies
                if (params.bowtie2_softclip as Boolean) {
                    args << "--ma ${params.bowtie2_ma as Integer}"
                }
            } else {
                // No dedicated -N/-D/-R params here: bowtie2's own built-in defaults apply.
                args << '-L 22'
                if (params.bowtie2_softclip as Boolean) {
                    args << '--local'
                    args << "--ma ${params.bowtie2_ma as Integer}"
                }
            }
            args << "--mp ${params.bowtie2_mp}"
            args << "--dpad ${params.bowtie2_dpad as Integer}"
            args << "--rdg ${params.bowtie2_rdg}"
            args << "--rfg ${params.bowtie2_rfg}"
            if (params.bowtie2_dovetail as Boolean) {
                args << '--dovetail'
            }
            args.join(' ').trim()
        }
    }

    withName: SAMTOOLS_SORT {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: SAMTOOLS_SORT_NAME {
        ext.args   = '-n'
        ext.prefix = { "${meta.id}.namesorted" }
        publishDir = [ enabled: false ]
    }

    withName: SAMTOOLS_FIXMATE {
        ext.args   = '-m'
        ext.prefix = { "${meta.id}.fixmate" }
        publishDir = [ enabled: false ]
    }

    withName: SAMTOOLS_QNAMES {
        publishDir = [ enabled: false ]
    }

    withName: SAMTOOLS_VIEW {
        ext.args   = '--output-fmt bam'
        ext.prefix = { "${meta.id}.dedup_transcript" }
        publishDir = [ enabled: false ]
        // --qname-file loads all surviving QNAMEs into memory; deep human samples need headroom
        memory     = { 24.GB * task.attempt }
    }

    withName: SAMTOOLS_SORT_TRANSCRIPT {
        ext.prefix = { "${meta.id}.transcript.sorted" }
        // -m raises the per-thread in-RAM buffer (default 768M) so the large multimapper BAM
        // spills far fewer temp chunks; 8 threads x 3G = 24G, under the 48G request in codon.config.
        ext.args   = '-m 3G'
        // No node-local scratch: sorting the AllBestScore-bloated transcriptome BAM spills
        // temp chunks that exhaust the compute node's $TMPDIR with ENOSPC.
        scratch = false
    }

    withName: SAMTOOLS_CALMD {
        ext.args   = '-b'
        ext.prefix = { "${meta.id}.transcript.calmd" }
        // No node-local scratch: the AllBestScore-bloated transcriptome BAM overflows the
        // compute node's $TMPDIR with ENOSPC; write straight to the work dir instead.
        scratch = false
    }

    withName: GFFREAD {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.transcripts" }
        // Genome route: publish the extracted transcript FASTA so transcript-coordinate tracks
        // (norm/transcript_bw, fold/…_transcript_bw) can be loaded against it in a genome browser.
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.fasta') ? filename.replaceFirst(/\.fasta$/, '.fa') : null }
        ]
    }

    withName: SAMTOOLS_MARKDUP {
        ext.args = '-r --no-multi-dup'
    }

    withName: 'RNAFRAMEWORK_RFCOUNT_GENOME' {
        // No node-local scratch: like RFCOUNT_STAR, the per-reference BAM split can exhaust the
        // compute node's local scratch ($TMPDIR) with ENOSPC.
        scratch = false
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // RT-stop counts RT-stops (default); MaP counts mutations (-m, collapse/quality via rfcount_map_* params).
        // Strandedness is controlled by --rfcount_strandedness (unstranded / first / second).
        ext.args   = {
            def is_map = (meta.principle ?: '').toLowerCase() == 'map'
            def args = []

            if (is_map) {
                args << '-m'
                // Four-base DMS: rf-count-genome has no -4d, so pass the mutation filter it presets on both routes.
                if (meta.four_base_dms) args << '-om H2N,G2Y -ncl'
                if ((params.rfcount_map_sort_by_read_name as Boolean) && !meta.single_end) {
                    args << '--sort-by-read-name'
                }
                if (params.rfcount_map_discard_shorter as Integer > 1) {
                    args << "--discard-shorter ${params.rfcount_map_discard_shorter as Integer}"
                }
                args << "--min-quality ${params.rfcount_map_min_quality as Integer}"
                // RT_enzyme-aware defaults (M-MLV is the common case; Group II Intron RTs e.g. TGIRT
                // behave differently), overridable via the explicit rfcount_map_* params.
                def rtEnzyme = (meta.RT_enzyme ?: '').toLowerCase()
                def isGroupIIRt = rtEnzyme.contains('group ii') || rtEnzyme.contains('tgirt')
                def collapseConsecutive = params.rfcount_map_collapse_consecutive != null
                    ? (params.rfcount_map_collapse_consecutive as Boolean)
                    : !isGroupIIRt
                if (collapseConsecutive) {
                    args << '--collapse-consecutive'
                    args << "--max-collapse-distance ${params.rfcount_map_max_collapse_distance as Integer}"
                }
                args << "--median-quality ${params.rfcount_map_median_quality as Integer}"
                if (params.rfcount_map_no_deletions as Boolean) {
                    args << '--no-deletions'
                }
                def noAmbiguous = params.rfcount_map_no_ambiguous != null
                    ? (params.rfcount_map_no_ambiguous as Boolean)
                    : isGroupIIRt
                if (noAmbiguous) {
                    args << '-na'
                }
                def noInsertions = params.rfcount_map_no_insertions != null
                    ? (params.rfcount_map_no_insertions as Boolean)
                    : isGroupIIRt
                if (noInsertions) {
                    args << '--no-insertions'
                }
                def rightDeletion = params.rfcount_map_right_deletion != null
                    ? (params.rfcount_map_right_deletion as Boolean)
                    : !isGroupIIRt
                if (rightDeletion) {
                    args << '--right-deletion'
                }
                def discardConsecutive = params.rfcount_map_discard_consecutive != null
                    ? params.rfcount_map_discard_consecutive as Integer
                    : (isGroupIIRt ? 3 : null)
                if (discardConsecutive != null) {
                    args << "-dc ${discardConsecutive}"
                }
                if (params.rfcount_map_eval_surrounding as Boolean) {
                    args << '--eval-surrounding'
                }
            }
            if (params.rfcount_img as Boolean) { args << "-g -R ${params.rnaframework_r_path}" }
            if (params.rfcount_trim_5prime as Integer > 0) {
                args << "-t5 ${params.rfcount_trim_5prime as Integer}"
            }
            if (params.rfcount_mask_file) {
                args << "--mask-file \"${params.rfcount_mask_file}\""
            }
            if (params.rfcount_primary_only as Boolean) {
                args << '--primary-only'
            }
            if (params.rfcount_discard_clipped_reads as Boolean) {
                args << '--discard-clipped-reads'
            }
            def paired_filter_requested = (params.rfcount_paired_only as Boolean) || (params.rfcount_properly_paired as Boolean)
            if (!meta.single_end) {
                if (params.rfcount_paired_only as Boolean) {
                    args << '--paired-only'
                } else if ((params.rfcount_properly_paired as Boolean) || !paired_filter_requested) {
                    args << '--properly-paired'
                }
            }
            // RT-stop reads are always second-strand by design (rf-count-genome rejects any other value).
            // MaP uses meta.strandedness from RSeQC infer_experiment, falling back to --rfcount_strandedness.
            def strandedness = is_map
                ? (meta.strandedness ?: params.rfcount_strandedness)
                : 'second'
            args << "--library-strandedness ${strandedness}"

            // Minimum MAPQ — genome aligners assign meaningful MAPQ scores; raise to
            // filter multi-mappers (e.g. --rfcount_genome_map_quality 10).
            if (params.rfcount_genome_map_quality as Integer > 0) {
                args << "--map-quality ${params.rfcount_genome_map_quality as Integer}"
            }
            args << "--block-size ${params.rfcount_genome_block_size as Integer}"
            if (params.rfcount_genome_samtools_threads as Integer > 1) {
                args << "--working-threads ${params.rfcount_genome_samtools_threads as Integer}"
            }

            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/count" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // The summary is republished by RFRCTOOLS_EXTRACT with 'covered' corrected to the
                // covered-transcript count; suppress the genome-reference-count version here.
                if (filename.endsWith('.rfcount_genome_summary.tsv')) return null
                filename.replaceFirst(/_rfcount_genome(?=\/|$)/, '')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFRCTOOLS_EXTRACT' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.args = {
            def args = []
            def gtf_feat = params.rfrctools_gtf_feature
            if (gtf_feat != 'exon') {
                args << "--GTFfeature ${gtf_feat}"
            }
            def gtf_attr = params.rfrctools_gtf_attribute
            if (gtf_attr != 'transcript_id') {
                args << "--GTFattribute ${gtf_attr}"
            }
            args.join(' ').trim()
        }
        // GTF feature/attribute for deriving covered-transcript lengths in the post-extract coverage
        // filter — must match the values used for the genome→transcript extract above.
        ext.gtf_feature   = { params.rfrctools_gtf_feature }
        ext.gtf_attribute = { params.rfrctools_gtf_attribute }
        // Coverage filter: drop transcripts with no base at coverage >= this value so the emitted RC
        // is covered-only (transcriptome-sized). Set to 0 to publish the full annotation RC instead.
        ext.min_coverage  = { params.rfnorm_prefilter_min_coverage as Integer }
        publishDir = [
            path: { "${params.outdir}/count" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                // Per-sample summary is superseded by the aggregated rfcount_summary_all_samples.tsv
                if (filename.endsWith('.rfcount_genome_summary.tsv')) return null
                filename.replaceFirst(/_rctools_extract(?=\/|$)/, '')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFJACKKNIFE' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.args = {
            def args = []
            args << "--slope ${params.rfjackknife_slope}"
            args << "--intercept ${params.rfjackknife_intercept}"
            args << "--slope-step ${params.rfjackknife_slope_step}"
            args << "--intercept-step ${params.rfjackknife_intercept_step}"
            if (params.rfjackknife_mfmi as Boolean)             { args << '--mFMI' }
            if (params.rfjackknife_relaxed as Boolean)           { args << '--relaxed' }
            if (params.rfjackknife_keep_lonelypairs as Boolean)  { args << '--keep-lonelypairs' }
            if (params.rfjackknife_keep_pseudoknots as Boolean)  { args << '--keep-pseudoknots' }
            if (params.rfjackknife_only_common as Boolean)       { args << '--only-common' }
            if (params.rfjackknife_img as Boolean) { args << "-g -R ${params.rnaframework_r_path}" }
            if (params.rfjackknife_rf_fold_params) { args << "-rp \"${params.rfjackknife_rf_fold_params}\"" }
            args << "-R ${params.rnaframework_r_path}"
            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/jackknife" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RNAFRAMEWORK_RFEVAL' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.args = {
            def args = []
            args << "--reactivity-cutoff ${params.rfeval_reactivity_cutoff as BigDecimal}"
            if (params.rfeval_ignore_terminal as Boolean) { args << '--ignore-terminal' }
            if (params.rfeval_terminal_as_unpaired as Boolean) { args << '--terminal-as-unpaired' }
            if (params.rfeval_keep_pseudoknots as Boolean) { args << '--keep-pseudoknots' }
            if (params.rfeval_keep_lonelypairs as Boolean) { args << '--keep-lonelypairs' }
            args.join(' ').trim()
        }
        // Rotation null, always on — the raw scores are meaningless without a per-structure
        // baseline. 200 caps the decoys for long references; short ones enumerate every rotation.
        ext.args2 = '--replicates 200 --min-shift 5'
        // Plotting is kept out of ext.args because only the main call takes it: the baseline
        // scores hundreds of decoys, so plotting them would dominate runtime and publish nothing.
        ext.args3 = { params.rfeval_img as Boolean ? "-g -R ${params.rnaframework_r_path}" : '' }
        publishDir = [
            path: { "${params.outdir}/eval" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // The *_rfeval_windows XMLs are an rf-eval input, not a result: one sliced
                // copy per reference region, regenerable from the XML and the manifest.
                if (filename.equals('versions.yml') || filename.contains('_rfeval_windows/')) { return null }
                // these already sit under eval/, so _rfeval on the per-sample dir is redundant
                filename.replaceFirst('_rfeval/', '/')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFSTRUCTEXTRACT' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.args = {
            def args = []
            args << "--winSize ${params.structextract_win_size as Integer}"
            args << "--minTranscriptLen ${params.structextract_min_transcript_len as Integer}"
            args << "--minValueFrac ${params.structextract_min_value_frac as BigDecimal}"
            args << "--minBelowMedian ${params.structextract_min_below_median as BigDecimal}"
            args << "--minPairedFrac ${params.structextract_min_paired_frac as BigDecimal}"
            args << "--minMotifLen ${params.structextract_min_motif_len as Integer}"
            if (params.structextract_max_motif_len != null) { args << "--maxMotifLen ${params.structextract_max_motif_len as Integer}" }
            if (params.structextract_max_loop_size != null) { args << "--maxLoopSize ${params.structextract_max_loop_size as Integer}" }
            if (params.structextract_ignore_react as Boolean)   { args << '--ignoreReact' }
            if (params.structextract_ignore_shannon as Boolean) { args << '--ignoreShannon' }
            if (params.structextract_multiway_only as Boolean)  { args << '--multiwayOnly' }
            if (params.structextract_one_per_file as Boolean)   { args << '--onePerFile' }
            if (params.structextract_eval_energy as Boolean) {
                args << '--evalEnergy'
                args << "--pvalue ${params.structextract_pvalue as BigDecimal}"
                args << "--nShufflings ${params.structextract_n_shufflings as Integer}"
                if (params.structextract_dinucl_shuffle as Boolean) { args << '--dinuclShuffle' }
            }
            args.join(' ').trim()
        }
        // RNAplot path for per-motif SVG diagrams; empty disables plotting. Extracted motifs are short,
        // so they are always drawn with ViennaRNA RNAplot regardless of r2dt mode (R2DT is not used here).
        ext.rnaplot = { (params.structextract_plot as Boolean) ? params.rffold_vienna_rnaplot : '' }
        publishDir = [
            // Nest under the fold sample dir alongside rffold.log, renaming the work-dir's
            // "<id>_structextract" directory to extracted_structures (dotbracket/ + images/ inside).
            path: { "${params.outdir}/fold/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.replaceFirst(/^.*_structextract(?=\/|$)/, 'extracted_structures') }
        ]
    }

    withName: 'RNAFRAMEWORK_RFCORRELATE_PEARSON' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.args = {
            def args = []
            if (params.rfcorrelate_cap_react != null) { args << "--cap-react ${params.rfcorrelate_cap_react}" }
            if (params.correlate_min_values != null)  { args << "--min-values ${params.correlate_min_values}" }
            if (params.correlate_ignore_sequence as Boolean) { args << '--ignore-sequence' }
            if (params.correlate_img as Boolean) { args << "-g -R ${params.rnaframework_r_path}" }
            args.join(' ').trim()
        }
        ext.prefix = { "${meta.id}.pearson" }
        publishDir = [
            path: { "${params.outdir}/correlate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RNAFRAMEWORK_RFCORRELATE_SPEARMAN' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.args = {
            def args = ['--spearman']
            if (params.correlate_min_values != null)  { args << "--min-values ${params.correlate_min_values}" }
            if (params.correlate_ignore_sequence as Boolean) { args << '--ignore-sequence' }
            if (params.correlate_img as Boolean) { args << "-g -R ${params.rnaframework_r_path}" }
            args.join(' ').trim()
        }
        ext.prefix = { "${meta.id}.spearman" }
        publishDir = [
            path: { "${params.outdir}/correlate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'RNAFRAMEWORK_RFCOUNT_STAR|RNAFRAMEWORK_RFCOUNT' {
        // No node-local scratch: "Splitting BAM files by reference" writes one file per transcript
        // (~250k for human), exhausting the compute node's local scratch ($TMPDIR) with ENOSPC.
        scratch = false
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // RT-stop: count RT-stops (default mode)
        // MaP:     count mutations (-m), with collapse and quality filters configurable via rfcount_map_* params
        ext.args   = {
            def is_map = (meta.principle ?: '').toLowerCase() == 'map'
            def args = []

            if (is_map) {
                args << '-m'
                // Four-base DMS: rf-count-genome has no -4d, so pass the mutation filter it presets on both routes.
                if (meta.four_base_dms) args << '-om H2N,G2Y -ncl'
                if ((params.rfcount_map_sort_by_read_name as Boolean) && !meta.single_end) {
                    args << '--sort-by-read-name'
                }
                if (params.rfcount_map_max_coverage != null) {
                    args << "--max-coverage ${params.rfcount_map_max_coverage as Integer}"
                }

                if (params.rfcount_map_discard_shorter as Integer > 1) {
                    args << "--discard-shorter ${params.rfcount_map_discard_shorter as Integer}"
                }
                args << "--min-quality ${params.rfcount_map_min_quality as Integer}"
                // RT_enzyme-aware defaults (M-MLV is the common case; Group II Intron RTs e.g. TGIRT
                // behave differently), overridable via the explicit rfcount_map_* params.
                def rtEnzyme = (meta.RT_enzyme ?: '').toLowerCase()
                def isGroupIIRt = rtEnzyme.contains('group ii') || rtEnzyme.contains('tgirt')
                def collapseConsecutive = params.rfcount_map_collapse_consecutive != null
                    ? (params.rfcount_map_collapse_consecutive as Boolean)
                    : !isGroupIIRt
                if (collapseConsecutive) {
                    args << '--collapse-consecutive'
                    args << "--max-collapse-distance ${params.rfcount_map_max_collapse_distance as Integer}"
                }
                args << "--median-quality ${params.rfcount_map_median_quality as Integer}"
                if (params.rfcount_map_no_deletions as Boolean) {
                    args << '--no-deletions'
                }
                def noAmbiguous = params.rfcount_map_no_ambiguous != null
                    ? (params.rfcount_map_no_ambiguous as Boolean)
                    : isGroupIIRt
                if (noAmbiguous) {
                    args << '-na'
                }
                def noInsertions = params.rfcount_map_no_insertions != null
                    ? (params.rfcount_map_no_insertions as Boolean)
                    : isGroupIIRt
                if (noInsertions) {
                    args << '--no-insertions'
                }
                def rightDeletion = params.rfcount_map_right_deletion != null
                    ? (params.rfcount_map_right_deletion as Boolean)
                    : !isGroupIIRt
                if (rightDeletion) {
                    args << '--right-deletion'
                }
                def discardConsecutive = params.rfcount_map_discard_consecutive != null
                    ? params.rfcount_map_discard_consecutive as Integer
                    : (isGroupIIRt ? 3 : null)
                if (discardConsecutive != null) {
                    args << "-dc ${discardConsecutive}"
                }
                if (params.rfcount_map_eval_surrounding as Boolean) {
                    args << '--eval-surrounding'
                }
            }
            if (params.rfcount_img as Boolean) { args << "-g -R ${params.rnaframework_r_path}" }
            if (params.rfcount_trim_5prime as Integer > 0) {
                args << "-t5 ${params.rfcount_trim_5prime as Integer}"
            }
            if (params.rfcount_mask_file) {
                args << "--mask-file \"${params.rfcount_mask_file}\""
            }
            if (params.rfcount_primary_only as Boolean) {
                args << '--primary-only'
            }
            if (params.rfcount_discard_clipped_reads as Boolean) {
                args << '--discard-clipped-reads'
            }

            // For paired-end data, default to properly paired reads unless a paired filter is explicitly set.
            def paired_filter_requested = (params.rfcount_paired_only as Boolean) || (params.rfcount_properly_paired as Boolean)
            if (!meta.single_end) {
                if (params.rfcount_paired_only as Boolean) {
                    args << '--paired-only'
                } else if ((params.rfcount_properly_paired as Boolean) || !paired_filter_requested) {
                    args << '--properly-paired'
                }
            }

            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/count" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                // Per-sample summary is superseded by the aggregated rfcount_summary_all_samples.tsv
                if (filename.endsWith('.rfcount_summary.tsv')) {
                    return null
                }
                // Empty on success; only holds content if rf-count's internal samtools split errors.
                if (filename.endsWith('samtools.log')) {
                    return null
                }
                filename.replaceFirst(/_rfcount(?=\/|$)/, '')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFNORMFACTOR' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // -sm/-nm are resolved per reference in NORMALISE_REACTIVITIES and carried on meta. The scoring
        // options below reuse RFNORMFACTOR's rfnorm_* params so the factor matches the reactivities.
        ext.args = {
            def isRtstop = (meta.principle ?: '').toLowerCase() == 'rt-stop'
            def minCoverage = params.rfnorm_normfactor_min_coverage != null
                ? params.rfnorm_normfactor_min_coverage as Integer
                : (isRtstop ? 50 : 1000)
            def args = [
                "-sm ${meta.rfnorm_scoring_method}",
                "-nm ${meta.rfnorm_norm_method}",
                "-mc ${minCoverage}"
            ]
            def isDms      = ((meta.method ?: '').toLowerCase() == 'dms')
            def isDmsBroad = isDms && meta.pH && (meta.pH as Double) >= 8.0
            def reactiveBases = params.rfnorm_reactive_bases ?: (isDms ? (isDmsBroad ? 'ACGU' : 'AC') : null)
            if (reactiveBases) args << "--reactive-bases ${reactiveBases}"
            // rf-norm -4d implies -ni and rejects a single -nf factor, so rf-normfactor must report one per base.
            if (meta.four_base_dms) args << '-ni'
            if (params.rfnorm_pseudocount != null) args << "--pseudocount ${params.rfnorm_pseudocount}"
            if (params.rfnorm_ignore_lower_than_untreated as Boolean) args << '--ignore-lower-than-untreated'
            if (params.rfnorm_median_coverage as BigDecimal > 0) args << "--median-coverage ${params.rfnorm_median_coverage}"
            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // norm_factors.txt duplicates the table already captured in the .log; the file itself
                // still flows to RNAFRAMEWORK_RFNORM internally for the -nf value lookup.
                if (filename.equals('versions.yml') || filename.endsWith('.norm_factors.txt')) return null
                filename
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFNORM' {
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // Dynamic rf-norm defaults by principle + controls: RT-stop+untreated=Ding(sm=1)/Box-plot(nm=3),
        // RT-stop only=Rouskin(sm=2)/90% Winsorizing(nm=2), MaP+untreated=Siegfried(sm=3)/Box-plot(nm=3),
        // MaP treated only=Zubradt(sm=4)/Box-plot(nm=3). Denatured is optional for Siegfried, added when present.
        ext.args   = {
            def args = [
                "-sm ${meta.rfnorm_scoring_method}",
                "-nm ${meta.rfnorm_norm_method}"
            ]
            if (params.rfnorm_remap_reactivities as Boolean) args << '--remap-reactivities'
            def isDms = ((meta.method ?: '').toLowerCase() == 'dms')
            def isDmsBroad = isDms && meta.pH && (meta.pH as Double) >= 8.0
            def reactiveBases = params.rfnorm_reactive_bases ?: (isDms ? (isDmsBroad ? 'ACGU' : 'AC') : null)
            def useDynamicWindow = params.rfnorm_dynamic_window != null ? (params.rfnorm_dynamic_window as Boolean) : (isDms && !isDmsBroad)
            def isRtstop = (meta.principle ?: '').toLowerCase() == 'rt-stop'
            def normWindow = params.rfnorm_norm_window != null ? (params.rfnorm_norm_window as Integer) : (((isDms && !meta.four_base_dms) || isRtstop) ? 50 : null)
            if (meta.four_base_dms) args << '-4d'
            if (reactiveBases) args << "--reactive-bases ${reactiveBases}"
            if (normWindow != null) args << "--norm-window ${normWindow}"
            if (params.rfnorm_window_offset != null) args << "--window-offset ${params.rfnorm_window_offset as Integer}"
            if (useDynamicWindow) args << '--dynamic-window'
            if (params.rfnorm_norm_independent as Boolean) args << '--norm-independent'
            if (params.rfnorm_raw as Boolean) args << '--raw'
            if (params.rfnorm_pseudocount != null) args << "--pseudocount ${params.rfnorm_pseudocount}"
            if (params.rfnorm_ignore_lower_than_untreated as Boolean) args << '--ignore-lower-than-untreated'
            if (params.rfnorm_mean_coverage as BigDecimal > 0) args << "--mean-coverage ${params.rfnorm_mean_coverage}"
            if (params.rfnorm_median_coverage as BigDecimal > 0) args << "--median-coverage ${params.rfnorm_median_coverage}"
            def nanThreshold = params.rfnorm_nan != null ? params.rfnorm_nan as Integer : (isRtstop ? 50 : 1000)
            args << "-n ${nanThreshold}"
            if (params.rfnorm_img as Boolean) { args << "--img -R ${params.rnaframework_r_path}" }
            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                def f = filename.replaceFirst(/_norm(?=\/|$)/, '')
                if (f.endsWith('.xml')) return f.replaceAll(/\/([^\/]+\.xml)$/, '/xml/$1')
                f
            }
        ]
    }

    withName: 'FASTA_SORT_LOCAL' {
        publishDir = [ enabled: false ]
    }

    withName: 'FASTA_SANITIZE_LOCAL|FASTA_SANITIZE_ENSEMBL|FASTA_SANITIZE_NCBI' {
        // Internal ID-sanitized working copy, upstream of FASTA_SORT_*; not published on its own.
        publishDir = [ enabled: false ]
    }

    withName: 'ENSEMBL_GENOME' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('ensembl_source_url.txt')) return 'ensembl_fasta_source_url.txt'
                return null
            }
        ]
    }

    withName: 'FASTA_SORT_ENSEMBL' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ENSEMBL_TRANSCRIPTOME' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                // Suppress raw compressed download — sorted FASTA is published by FASTA_SORT_ENSEMBL
                if (filename.equals('versions.yml') || filename.endsWith('.transcripts.fa.gz')) return null
                filename
            }
        ]
    }

    withName: 'ENSEMBL_GTF' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.endsWith('.not_found')) return null
                if (filename.equals('ensembl_source_url.txt')) return 'ensembl_gtf_source_url.txt'
                if (filename.endsWith('.gtf') && !filename.endsWith('.gtf.gz')) return null
                filename
            }
        ]
    }

    withName: 'GTF_SANITIZE' {
        // Internal ID-sanitized working copy; raw GTF is already published to reference/.
        publishDir = [ enabled: false ]
    }

    withName: 'FASTA_SORT_NCBI' {
        // Sorted/decompressed FASTA actually used downstream (STAR/samtools faidx reject the raw
        // gzip download) — published to reference/ to mirror FASTA_SORT_ENSEMBL.
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NCBI_FASTA' {
        // Raw compressed FASTA is not published — the sorted copy actually used downstream is
        // published to reference/ by FASTA_SORT_NCBI. Only the source-accession provenance list
        // (not tied to the raw file) is published here, alongside the rest of the reference.
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('ncbi_source_accessions.txt') ? filename : null }
        ]
    }

    withName: 'NCBI_GTF' {
        // NCBI's synthetic GTF has no separate sort step (unlike FASTA), so its raw output is
        // itself the reference actually used downstream — publish directly to reference/.
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.gtf') ? filename : null }
        ]
    }

    withName: 'RNAFRAMEWORK_RFFOLD' {
        // No node-local scratch: at high transcript counts the glob outputs overflow ARG_MAX in
        // Nextflow's scratch-unstage `ls`, failing with "Missing output file" despite rf-fold succeeding.
        scratch = false
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        // Defaults: dot-bracket output (do not pass -ct unless requested), -g graphical reports when
        // rffold_img is true; multiple XML inputs (replicates) allowed.
        ext.args   = {
            def args = []
            if (params.rffold_img as Boolean) { args << "-g -R ${params.rnaframework_r_path}" }
            if (params.rffold_ct as Boolean) args << '-ct'
            if (params.rffold_window != null) {
                args << '-w'
                args << "-fw ${params.rffold_window as Integer}"
            }
            if (params.rffold_partition_window != null) args << "-pw ${params.rffold_partition_window as Integer}"
            if (params.rffold_unconstrained as Boolean) args << '-i'
            if (params.rffold_vienna_no_lonely_pairs as Boolean) args << '-nlp'
            if (params.rffold_vienna_constrained as Boolean) args << '-hc'
            if (params.rffold_vienna_max_bp_span != null) args << "-md ${params.rffold_vienna_max_bp_span as Integer}"
            // -oc/--only-common: fold only transcripts present in at least N replicate EXPERIMENT DIRS
            // (not the transcript-XML count). Auto-enable at the replicate count unless user set a value.
            def experiment_count = meta.fold_experiment_count as Integer ?: 1
            if (params.rffold_only_common != null) {
                args << "-oc ${params.rffold_only_common as Integer}"
            } else if (experiment_count > 1) {
                args << "-oc ${experiment_count}"
            }
            if ((params.rffold_use_alifold as Boolean) && experiment_count > 1) args << '-ua'
            if (params.rffold_fold_constraint_file) args << "-c ${params.rffold_fold_constraint_file}"
            if (params.rffold_dotplot as Boolean) args << '-dp'
            if (params.rffold_shannon_entropy as Boolean) args << '-sh'
            // Chemical-specific slope/intercept (DMS: doi:10.1038/s41587-025-02739-0; NAI/2A3: doi:10.1093/nar/gkaa1255);
            // any other/unset chemical uses generic defaults. jackknife calibration and explicit
            // --rffold_slope/--rffold_intercept both take priority over these.
            def chemicalDefaults = [ dms: [4.6, -2], nai: [2.2, -0.8], '2a3': [1, -0.4] ]
            def defaults = chemicalDefaults[(meta.chemical ?: '').toLowerCase()] ?: [1.8, -0.6]
            def slope     = meta.jackknife_slope     != null ? meta.jackknife_slope     : (params.rffold_slope     != null ? params.rffold_slope     : defaults[0])
            def intercept = meta.jackknife_intercept != null ? meta.jackknife_intercept : (params.rffold_intercept != null ? params.rffold_intercept : defaults[1])
            if (slope     != null) args << "-sl ${slope}"
            if (intercept != null) args << "-in ${intercept}"
            args.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename ==~ /.+_fold(\/.*)?$/) return null
                if (filename.contains('/dotplot/')) return null
                if (filename.contains('/dotbracket/')) return null
                filename.replaceFirst(/_fold_publish(?=\/|$)/, '')
            }
        ]
    }

    withName: 'RNAFRAMEWORK_DOTPLOT2BP' {
        ext.args = '--ucsc-common-chrom-names --min-color-index 1'
        publishDir = [ enabled: false ]
    }

    withName: 'RNAFRAMEWORK_DOTPLOT2BP_TRANSCRIPT' {
        ext.args = '--transcript-coords --min-color-index 1'
        // Per-transcript arcs, ~10x smaller than the rf-fold dot plots behind them; those stay in
        // the work dir, so only pairs at >=10% probability are published.
        publishDir = [
            path: { "${params.outdir}/fold/${meta.id}/bp" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.bp') ? filename.substring(filename.lastIndexOf('/') + 1) : null }
        ]
    }

    withName: 'MERGE_BP' {
        ext.prefix = { "${meta.id}_genome" }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                "genome_bp/${filename}"
            }
        ]
    }

    withName: 'MERGE_BP_TRANSCRIPT' {
        ext.prefix = { "${meta.id}_transcript" }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                "transcript_bp/${filename}"
            }
        ]
    }

    withName: 'RNAFRAMEWORK_RFWIGGLE' {
        ext.args = {
            def args = []
            if (params.rfwiggle_report_zeroes as Boolean) args << '-z'
            if (params.rfwiggle_keep_bases) args << "-kb ${params.rfwiggle_keep_bases}"
            args.join(' ').trim()
        }
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                def f = filename.replaceFirst(/_norm(?=\/|$)/, '')
                def m = (f =~ /^(.+?)(?=_wiggle\/)/)
                def sampleId = m ? m[0][1] : null
                if (!sampleId) return f
                def renamed = f.replaceFirst("^${sampleId}_wiggle/", 'wiggle/')
                "${sampleId}/${renamed}"
            }
        ]
    }

    withName: 'MERGE_WIG' {
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }

    withName: 'AVERAGE_WIG' {
        publishDir = [ enabled: false ]
    }

    withName: 'WIG_TO_GENOME_REACTIVITY' {
        ext.args = '--ucsc-common-chrom-names'
        publishDir = [ enabled: false ]
    }

    withName: 'WIG_TO_GENOME_SHANNON' {
        ext.args = '--ucsc-common-chrom-names'
        publishDir = [ enabled: false ]
    }

    withName: 'UCSC_WIGTOBIGWIG_REACTIVITY' {
        ext.prefix = { "${meta.sample_group}_reactivity_genome" }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                "genome_bw/${filename}"
            }
        ]
    }

    withName: 'WIG_CHROM_SIZES_REACTIVITY' {
        publishDir = [ enabled: false ]
    }

    withName: 'UCSC_WIGTOBIGWIG_TRANSCRIPT_REACTIVITY' {
        ext.prefix = { "${meta.sample_group}_reactivity_transcript" }
        publishDir = [
            path: { "${params.outdir}/norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                "transcript_bw/${filename}"
            }
        ]
    }

    withName: 'MERGE_SHANNON_WIG' {
        ext.prefix = { "${meta.id}" }
        publishDir = [ enabled: false ]
    }

    withName: 'UCSC_WIGTOBIGWIG_SHANNON' {
        ext.prefix = { "${meta.sample_group}_shannon_genome" }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                "shannon_genome_bw/${filename}"
            }
        ]
    }

    withName: 'WIG_CHROM_SIZES_SHANNON' {
        publishDir = [ enabled: false ]
    }

    withName: 'UCSC_WIGTOBIGWIG_TRANSCRIPT_SHANNON' {
        ext.prefix = { "${meta.sample_group}_shannon_transcript" }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                "shannon_transcript_bw/${filename}"
            }
        ]
    }

    withName: 'RNAFRAMEWORK_TORDAT' {
        ext.prefix = { "${meta.sample_group}" }
        ext.args   = { "--pipeline-version '${workflow.manifest.version ?: 'unknown'}'" }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) {
                    return null
                }
                // Base-pair probabilities sit with the other pairing outputs in bp/, not beside the RDAT.
                def subdir = filename.endsWith('.bpp.tsv') ? 'bp' : 'rdat'
                filename.replaceFirst(/^(.+?)_rdat\//, "\$1/${subdir}/")
            }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.endsWith('.html')) return filename
                return null
            }
        ]
    }

    withName: 'R2DT' {
        // No node-local scratch: Traveler fails to write SVGs under some scratch mounts (draws exit 0
        // but results/svg stays empty), and the per-transcript *.svg glob overflows the scratch-unstage
        // `ls` at high counts (like RFFOLD/VIENNARNA).
        scratch = false
        ext.templatable_biotypes = params.r2dt_templatable_biotypes
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                if (filename.equals('r2dt_drawn_ids.txt')) return null
                filename.replaceFirst(/_r2dt(?=\/|\.log$|$)/, '/structures/r2dt')
            }
        ]
    }

    withName: 'VIENNARNA' {
        // No node-local scratch: like RFFOLD, this emits a per-structure *.svg glob that at high
        // transcript counts overflows ARG_MAX in Nextflow's scratch-unstage `ls` ("Missing output file").
        scratch = false
        containerOptions = {
            if (workflow.containerEngine == 'docker') {
                def isArm64 = (System.getProperty('os.arch') in ['aarch64', 'arm64'])
                return isArm64 ? '-u $(id -u):$(id -g)' : '--platform linux/amd64 -u $(id -u):$(id -g)'
            }
            if (workflow.containerEngine == 'singularity') {
                return '--no-home'
            }
            ''
        }
        ext.rnaplot = { params.rffold_vienna_rnaplot }
        publishDir = [
            path: { "${params.outdir}/fold" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml')) return null
                filename.replaceFirst(/_structures(?=\/|$)/, '/structures/viennarna')
            }
        ]
    }

}

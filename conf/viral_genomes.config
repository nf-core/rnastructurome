// conf/viral_genomes.config — curated NCBI accessions for viral organisms, loaded automatically.
// Key = normalised organism string (lowercase, non-[a-z0-9_] runs → '_', trimmed), e.g. "Rotavirus A strain RF" → rotavirus_a_strain_rf.
// Segmented genomes list all segment accessions in genome order, concatenated into one alignment FASTA.
// Viral references never have an Ensembl-compatible GTF, so the dotplot-to-bp step is auto-skipped for them.

params {
    ncbi_accessions_map = [

        // Influenza A — segments listed in genome order (1–8). All accessions are cRNA
        // (positive-sense) orientation at NCBI, consistent with mapping RT-stop and DMS-MaP reads.

        // A/Puerto Rico/8/1934(H1N1) — PR8; RefSeq NC_ reference sequences
        'influenza_a_virus_a_puerto_rico_8_1934_h1n1': [
            'NC_002023.1',  // seg 1 PB2
            'NC_002021.1',  // seg 2 PB1
            'NC_002022.1',  // seg 3 PA
            'NC_002017.1',  // seg 4 HA (H1)
            'NC_002019.1',  // seg 5 NP
            'NC_002018.1',  // seg 6 NA (N1)
            'NC_002016.1',  // seg 7 M
            'NC_002020.1',  // seg 8 NS
        ],

        // A/WSN/1933(H1N1) — WSN/33 lab-adapted strain (CY NCBI Flu series)
        'influenza_a_virus_a_wsn_1933_h1n1': [
            'CY034139.1',   // seg 1 PB2
            'CY034138.1',   // seg 2 PB1
            'CY034137.1',   // seg 3 PA
            'CY034132.1',   // seg 4 HA (H1)
            'CY034135.1',   // seg 5 NP
            'CY034134.1',   // seg 6 NA (N1)
            'CY034133.1',   // seg 7 M
            'CY034136.1',   // seg 8 NS
        ],

        // A/Udorn/307/1972(H3N2) — Udorn lab strain (CY NCBI Flu series)
        'influenza_a_virus_a_udorn_307_1972_h3n2': [
            'CY009643.1',   // seg 1 PB2
            'CY009642.1',   // seg 2 PB1
            'CY009641.1',   // seg 3 PA
            'CY009636.1',   // seg 4 HA (H3)
            'CY009639.1',   // seg 5 NP
            'CY009638.1',   // seg 6 NA (N2)
            'CY009637.1',   // seg 7 M
            'CY009640.1',   // seg 8 NS
        ],

        // ── SARS-CoV-2 ────────────────────────────────────────────────────────

        // Wuhan-Hu-1 — NCBI RefSeq reference genome (29,903 bp)
        'severe_acute_respiratory_syndrome_coronavirus_2_isolate_wuhan_hu_1': [
            'NC_045512.2',
        ],

        // USA-WA1/2020 — first confirmed US isolate; BEI Resources passage
        'severe_acute_respiratory_syndrome_coronavirus_2_isolate_usa_wa1_2020': [
            'MT576563.1',
        ],

        // Leiden-0002 — Dutch clinical isolate (Netherlands, 2020)
        'severe_acute_respiratory_syndrome_coronavirus_2_isolate_leiden_0002': [
            'MT510999.1',
        ],

        // Δ382 mutant — 382-nt deletion (ORF7b/ORF8, Singapore 2020), GISAID-only (EPI_ISL_414378).
        // Wuhan-Hu-1 is used as the mapping reference; coverage is zero over ~nt 27,848–28,229 of NC_045512.2.
        'severe_acute_respiratory_syndrome_coronavirus_2_delta382_mutant': [
            'NC_045512.2',
        ],

        // ── Dengue virus ──────────────────────────────────────────────────────
        // Four EDEN (Singapore) strains sequenced by Schreiber et al. 2009 (PMID 19204579);
        // single-segment ~10.7 kb positive-sense RNA genome. Keys derive from the samplesheet organism string.

        // Serotype 1 — Singapore clinical isolate D1/SG/05K2402DK1/2005
        'dengue_virus_1_strain_eden2402': [
            'EU081230.1',
        ],

        // Serotype 2 — Singapore clinical isolate D2/SG/05K3295DK1/2005
        'dengue_virus_2_strain_eden3295': [
            'EU081177.1',
        ],

        // Serotype 3 — Singapore clinical isolate D3/SG/05K863DK1/2005
        'dengue_virus_3_strain_eden863': [
            'EU081190.1',
        ],

        // Serotype 4 — Singapore clinical isolate DENV-4/SG/06K2270DK1/2005
        'dengue_virus_4_strain_eden2270': [
            'GQ398256.1',
        ],

        // Serotype 2 — Thai isolate 16803 (candidate vaccine strain)
        'dengue_virus_2_strain_s16803': [
            'GU289914.1',
        ],

        // ── Zika virus ────────────────────────────────────────────────────────

        // French Polynesia 2013 outbreak strain H/PF/2013 (10,794 bp)
        'zika_virus_french_polynesia_strain': [
            'KJ776791.2',
        ],

        // HPF2013 — same sequence as zika_virus_french_polynesia_strain above
        'zika_virus_strain_hpf2013': [
            'KJ776791.2',
        ],

        // MR766 — Uganda 1947 prototype strain; NCBI RefSeq reference
        'zika_virus_mr766': [
            'NC_012532.1',
        ],

        // MR766 — original 1947 Uganda isolate deposit (AY632535.2);
        // differs slightly from the RefSeq NC_012532.1 assembly above
        'zika_virus_strain_mr766': [
            'AY632535.2',
        ],

        // BeH815744 — Brazil 2015 outbreak isolate (Campos et al. 2016)
        'zika_virus_strain_beh815744': [
            'KU365780.1',
        ],

        // ── HIV-1 ─────────────────────────────────────────────────────────────

        // NL4-3 — chimeric lab strain (NY5 × LAI); 9,709 bp proviral sequence
        'human_immunodeficiency_virus_1_nl4_3': [
            'AF324493.2',
        ],

        // Rotavirus A — RF is a bovine G6P[6] strain, 11 dsRNA segments. VP7 is segment 7 here
        // (vs. segment 9 in SA11/Wa) due to different size-ordering. Sequences from Trask et al. 2013 (PMC3760874).
        'rotavirus_a_strain_rf': [
            'KF729687.1',   // seg 1  VP1
            'KF729688.1',   // seg 2  VP2
            'KF729689.1',   // seg 3  VP3
            'KF729690.1',   // seg 4  VP4
            'KF729691.1',   // seg 5  NSP1
            'KF729692.1',   // seg 6  VP6
            'KF729693.1',   // seg 7  VP7 (G6)
            'KF729694.1',   // seg 8  NSP2
            'KF729695.1',   // seg 9  NSP3
            'KF729696.1',   // seg 10 NSP4
            'KF729697.1',   // seg 11 NSP5/NSP6
        ],
    ]
}

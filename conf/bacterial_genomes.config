// conf/bacterial_genomes.config — curated NCBI accessions for bacterial organisms, loaded automatically.
// Key = lowercase organism string with runs of non-alphanumerics replaced by '_' (e.g. "Escherichia coli" → "escherichia_coli").
// Bacteria aren't served by main Ensembl, so pinning RefSeq accessions here keeps alignment reproducible and strain-matched.

params {
    ncbi_accessions_map = [

        // Escherichia coli — K-12 MG1655, the standard lab reference strain (complete chromosome).
        // Use for any E. coli experiment where the strain is unknown or a K-12 derivative.
        'escherichia_coli': [
            'NC_000913.3',
        ],

    ]
}

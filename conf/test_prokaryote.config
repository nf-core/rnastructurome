/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running prokaryote transcriptome-mode tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Exercises the --transcriptome route on an E. coli 16S rRNA DMS-MaP dataset.
    The profile uses a single 16S rRNA FASTA and a matching 16S-only dot-bracket
    reference for rf-jackknife calibration and rf-eval accuracy scoring.

    Data is pulled from nf-core/test-datasets (rnastructurome branch):
        testdata/test_prokaryote/16S_rRNA.fa            - 16S rRNA FASTA
        testdata/test_prokaryote/16S_rRNA.gtf           - matching one-transcript GTF
        testdata/test_prokaryote/16S_rRNA.reference.db  - 16S rRNA dot-bracket reference

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test_prokaryote,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test prokaryote profile'
    config_profile_description = 'E. coli 16S rRNA DMS-MaP test dataset to check pipeline function (Bowtie transcriptome route)'

    input        = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_prokaryote/samplesheet.prokaryote_test.csv'

    method       = 'DMS'
    principle    = 'MaP'
    organism     = 'Escherichia coli'
    fasta        = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_prokaryote/16S_rRNA.fa'
    gtf          = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_prokaryote/16S_rRNA.gtf'
    transcriptome = true
    rfnorm_nan   = 0     // disable NaN masking; test reads are too few to meet the default coverage threshold

    jackknife_reference = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_prokaryote/16S_rRNA.reference.db'
    rfjackknife_pool_all = false

    rfeval_reference    = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_prokaryote/16S_rRNA.reference.db'
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Settings shared by the conda and mamba profiles
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// On macOS arm64, install osx-64 packages and run them under Rosetta 2.
conda.createOptions = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? '--platform osx-64' : ''
env.CONDA_SUBDIR    = (System.getProperty('os.arch') in ['aarch64', 'arm64']) ? 'osx-64' : null

params {
    rnaframework_r_path   = '$(command -v R)'
    rffold_vienna_rnaplot = '$(command -v RNAplot)'
    r2dt                  = false
}

process {
    // These macOS-only overrides live here rather than in the modules, so the modules stay the same for everyone else.
    // lbzip2 is Linux-only and sed=4.8 has no osx-64 build, so macOS gets an inline spec without them.
    withName: 'CAT_FASTQ' {
        conda = System.getProperty('os.name')?.contains('Mac') ? 'conda-forge::coreutils=9.5 conda-forge::grep=3.11 conda-forge::gzip=1.13 conda-forge::sed conda-forge::tar=1.34' : null
    }
    // Inline specs on macOS arm64, since `conda env create` from environment.yml ignores --platform; keep versions in step with each module's environment.yml.
    withName: 'RNAFRAMEWORK_RFCOUNT|RNAFRAMEWORK_RFCOUNT_GENOME|RNAFRAMEWORK_RFNORMFACTOR|RNAFRAMEWORK_RFNORM|RNAFRAMEWORK_RFSTRUCTEXTRACT|RNAFRAMEWORK_RFCORRELATE|RNAFRAMEWORK_RFRCTOOLS_EXTRACT|RNAFRAMEWORK_RFJACKKNIFE|RNAFRAMEWORK_RFEVAL' {
        conda        = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.8' : null
        beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
    }
    withName: 'RNAFRAMEWORK_RFFOLD' {
        conda        = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.8 bioconda::viennarna=2.7.2 conda-forge::perl' : null
        beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
    }
    withName: 'RNAFRAMEWORK_RFWIGGLE' {
        conda        = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::rnaframework=2.9.8 bioconda::ucsc-bedgraphtobigwig' : null
        beforeScript = 'export PATH="${CONDA_PREFIX}/bin:${PATH}"'
    }
    withName: 'STAR_GENOMEGENERATE|STAR_ALIGN_RTSTOP|STAR_ALIGN_MAP' {
        conda = ((System.getProperty('os.arch') in ['aarch64', 'arm64']) && System.getProperty('os.name')?.contains('Mac')) ? 'bioconda::star=2.7.11b bioconda::samtools=1.21 bioconda::htslib=1.21 conda-forge::gawk=5.1.0' : null
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Rice (Oryza sativa) in vivo DMS-MaPseq from Yang et al. 2022 (doi:10.3389/fpls.2022.869267,
    GEO GSE197245): one DMS(-) control and three DMS(+) treated replicates. Reads stream
    from ENA; the genome and GTF are fetched automatically from Ensembl Plants (the download
    scripts fall back through the EnsemblGenomes divisions), exercising the full STAR genome route.

    Use as follows:
        nextflow run nf-core/rnastructurome -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Rice (Oryza sativa) in vivo DMS-MaPseq full-size test dataset (STAR genome route)'

    // Input data for full size test — one DMS(-) control + three DMS(+) replicates (GSE197245).
    input = params.pipelines_testdata_base_path + 'rnastructurome/testdata/test_full/samplesheet.oryza_sativa.csv'

    // Reference resolves from the samplesheet organism (Oryza sativa) via Ensembl Plants;
    // the default genome route (STAR + --quantMode TranscriptomeSAM) is used.
    method    = 'DMS'
    principle = 'MaP'
    organism  = 'Oryza sativa'
}

nextflow_process {

    name "Test Process RNAFRAMEWORK_RFSTRUCTEXTRACT"
    script "../main.nf"
    process "RNAFRAMEWORK_RFSTRUCTEXTRACT"

    tag "modules"
    tag "modules_local"
    tag "rnaframework"
    tag "rnaframework/structextract"
    config "./nextflow.config"

    test("rfstructextract - stub") {

        options "-stub"

        when {
            params {
                module_args = ''
            }
            process {
                """
                input[0] = Channel.of([
                    [ id:'HEK293T' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.sorted.bam', checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.motifs.size() == 1 },
                { assert process.out.log.size() == 1 },
                { assert process.out.versions_rnaframework[0][1] == 'rnaframework' && process.out.versions_rnaframework[0][2] }
            )
        }
    }
}
